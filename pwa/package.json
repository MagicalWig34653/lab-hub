{
	"name": "lab-hub-pwa",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:mock": "VITE_MOCK=1 vite dev",
		"build": "node scripts/generate-licenses.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api/types.ts",
		"check:api": "node scripts/check-api-types.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:api",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:mock": "VITE_MOCK=1 npm run build && playwright test -c playwright.mock.config.ts"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"license": "AGPL-3.0-only",
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.70.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"jsdom": "^30.1.3",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
