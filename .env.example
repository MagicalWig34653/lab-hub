# Lokale Entwicklung (compose.yaml im Repo-Root). Kopieren nach .env, nie committen.
DB_PASSWORD=bitte-lokal-setzen
DB_NAME=labhub
DB_USER=labhub
DB_HOST_PORT=15432

# Backend / Deploy (siehe deploy/README.md)
DB_HOST=127.0.0.1
DB_PORT=15432
DB_TLS=disable
PUBLIC_URL=https://hub.example.org
WEBAUTHN_RP_ID=hub.example.org
BACKEND_PORT=8080
BACKEND_REPLICAS=2

# Optional (WP-H6, siehe deploy/README.md, Abschnitt Härtung)
# Vertraute Reverse Proxys für X-Forwarded-For (Rate-Limit), kommagetrennt, IPv4/IPv6 mit optionalem Präfix. Standard: keine.
TRUSTED_PROXIES=
# Speicherquota je Mandant in Bytes (Standard 1 TiB); Upload darüber: 413 storage_quota_exceeded
DMS_TENANT_QUOTA_BYTES=1099511627776

# Quellen (WP-D4, siehe deploy/README.md, Abschnitt Quellen): nur am Worker-Dienst wirksam
# Schlüssel für Zugangsdaten der Mail-Quellen (SECRET_KEY / Secret lh_secret_key, mindestens 32 Byte, erzeugen mit `openssl rand -base64 32`; ein zu kurzer Schlüssel verhindert den Start); ohne ihn keine Mail-Quellen. Nie committen.
# Zertifikatsprüfung für IMAP (Standard true; false nur im Labor), eigene CA-Datei und optionale Positivliste erlaubter IMAP-Hosts (kommagetrennt)
DMS_MAIL_TLS_VERIFY=true
DMS_MAIL_CA_PATH=
DMS_MAIL_HOST_ALLOWLIST=
# WP-H10: Mail-Quelle und Paperless-Import blockieren standardmäßig interne Ziele (Loopback, private Netze, Link-Local/Metadaten, ULA; Namen werden vor jedem Connect aufgelöst).
# true erlaubt interne Ziele ausdrücklich (Heim-/Test-Setups, Mailserver im selben Netz). Mail-Port: nur 993, weitere kommagetrennt freigeben.
DMS_ALLOW_INTERNAL_TARGETS=false
DMS_MAIL_PORT_ALLOWLIST=
# Konsumordner: Volume (benannt oder absoluter Host-Pfad), im Worker unter /mnt/consume/<mandanten-uuid>/<Pfad der Quelle>; Standard: benanntes Volume labhub-consume
DMS_FOLDER_SOURCE=labhub-consume
# Paperless-Import: Volume mit Export-Verzeichnissen (nur lesend im Worker unter /mnt/import/<mandanten-uuid>/<Pfad>) und optionale Positivliste erlaubter Paperless-Hosts (kommagetrennt, host oder host:port)
DMS_IMPORT_SOURCE=labhub-import
DMS_IMPORT_HOST_ALLOWLIST=


# PWA-Auslieferung durch das Backend (WP-H9, siehe deploy/README.md, Abschnitt PWA)
# PWA_DIR: im Image fest /usr/share/lab-hub/pwa; nur für Entwicklung ohne Image setzen (Ordner mit index.html, sonst Startfehler)
PWA_DIR=
# PWA_ENABLED=false: reines API-Backend ohne PWA (Standard true)
PWA_ENABLED=true
# HSTS in Sekunden, nur hinter einem TLS-Proxy setzen (0/leer = aus)
PWA_HSTS_MAX_AGE=

# Objektspeicher (WP-D1): db (Standard), fs (OBJECT_STORE_FS_PATH = absoluter Pfad eines Volumes, nur ein Host), s3 (noch nicht implementiert)
OBJECT_STORE=db
OBJECT_STORE_FS_PATH=
# Anzahl Backend-Repliken, nur für die Warnung bei OBJECT_STORE=fs mit mehr als einer Replik (setup.sh trägt BACKEND_REPLICAS ein)
HUB_REPLICAS=1

# Erstes Bootstrap-Fenster (WP-K1): einmaliges Geheimnis für den ersten Nutzer; nur während der Einrichtung setzen, danach entfernen (nie committen)
SETUP_TOKEN=
# Schlüssel für verschlüsselte Zugangsdaten (SECRET_KEY oder SECRET_KEY_FILE, mindestens 16 Zeichen); compose/swarm nutzen das Secret lh_secret_key
SECRET_KEY=
# Aufbewahrung in Jahren (Standard je Dokumenttyp bzw. 10), Upload-Grenze je Datei, OCR am Backend
DMS_DEFAULT_RETENTION_YEARS=
DMS_MAX_UPLOAD_BYTES=
DMS_OCR_ENABLED=true

# Worker-Feineinstellung (alle optional, siehe deploy/README.md)
OCR_TIMEOUT_SECONDS=600
OCR_MEMORY_MB=4096
OCR_MAX_PAGES=300
OCR_LANGUAGES=deu+eng
OCR_JOBS=2
OCR_DEHYPHENATE=true
DMS_MAIL_SESSION_TIMEOUT_SECONDS=
DMS_REGEX_TIMEOUT_MS=
