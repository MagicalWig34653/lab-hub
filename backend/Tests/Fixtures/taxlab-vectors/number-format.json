{
  "suite": "number-format",
  "note": "Synthetic. Reference: TaxlabModel NumberFormat (format, counterScope, seriesKey, match). expected is either a string or {error}.",
  "vectors": [
    {"id": "year-month-counter5", "input": {"template": "{YYYY}-{MM}-{N:5}", "year": 2026, "month": 3, "counter": 42, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"formatted": "2026-03-00042", "counterScope": "perMonth", "seriesKey": "invoice-2026-3", "match": {"year": 2026, "month": 3, "counter": 42}}},
    {"id": "short-year", "input": {"template": "{YY}{N}", "year": 2026, "month": 3, "counter": 42, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"formatted": "2642", "counterScope": "perYear", "seriesKey": "invoice-2026", "match": {"year": 2026, "month": null, "counter": 42}}},
    {"id": "prefix-literal", "input": {"template": "RE-{YYYY}-{N:4}", "year": 2026, "month": 3, "counter": 7, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"formatted": "RE-2026-0007", "counterScope": "perYear", "seriesKey": "invoice-2026", "match": {"year": 2026, "month": null, "counter": 7}}},
    {"id": "abbr-client-project", "input": {"template": "{ABBR}/{CLIENT}/{PROJECT}/{N:3}", "year": 2026, "month": 3, "counter": 4, "abbreviation": "RE", "clientNumber": "K007", "projectCode": "WEB"},
     "expected": {"formatted": "RE/K007/WEB/004", "counterScope": "continuous", "seriesKey": "invoice", "match": null}},
    {"id": "escaped-braces", "input": {"template": "{{{N}}}", "year": 2026, "month": 3, "counter": 42, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"formatted": "{42}", "counterScope": "continuous", "seriesKey": "invoice", "match": {"year": null, "month": null, "counter": 42}}},
    {"id": "counter-overflow-digits", "input": {"template": "{N:3}", "year": 2026, "month": 3, "counter": 123456, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"formatted": "123456", "counterScope": "continuous", "seriesKey": "invoice", "match": {"year": null, "month": null, "counter": 123456}}},
    {"id": "continuous", "input": {"template": "R{N:6}", "year": 2026, "month": 3, "counter": 1, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"formatted": "R000001", "counterScope": "continuous", "seriesKey": "invoice", "match": {"year": null, "month": null, "counter": 1}}},
    {"id": "december", "input": {"template": "{YYYY}{MM}-{N:3}", "year": 2027, "month": 12, "counter": 999, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"formatted": "202712-999", "counterScope": "perMonth", "seriesKey": "invoice-2027-12", "match": {"year": 2027, "month": 12, "counter": 999}}},
    {"id": "error-unknown-token", "input": {"template": "{FOO}{N}", "year": 2026, "month": 3, "counter": 42, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"error": "unknownToken(\"FOO\")"}},
    {"id": "error-unbalanced", "input": {"template": "{N", "year": 2026, "month": 3, "counter": 42, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"error": "unbalancedBrace"}},
    {"id": "error-no-counter", "input": {"template": "{YYYY}", "year": 2026, "month": 3, "counter": 42, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"error": "counterCount(0)"}},
    {"id": "error-two-counters", "input": {"template": "{N}{N}", "year": 2026, "month": 3, "counter": 42, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"error": "counterCount(2)"}},
    {"id": "error-zero-digits", "input": {"template": "{N:0}", "year": 2026, "month": 3, "counter": 42, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"error": "invalidDigits(\"0\")"}},
    {"id": "error-missing-client", "input": {"template": "{CLIENT}-{N}", "year": 2026, "month": 3, "counter": 42, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"error": "missingValue(\"CLIENT\")"}},
    {"id": "error-counter-zero", "input": {"template": "{N}", "year": 2026, "month": 3, "counter": 0, "abbreviation": null, "clientNumber": null, "projectCode": null},
     "expected": {"error": "invalidCounter"}}
  ]
}
